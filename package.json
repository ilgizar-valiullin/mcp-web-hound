{
  "name": "mcp-web-hound",
  "version": "1.12.0",
  "description": "MCP Web Hound — unified web search, GitHub search, and GitLab search tools with caching, reranking, and rate limits",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-web-hound": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "default.env"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "configure": "node dist/cli/configure.js",
    "export-logs": "node dist/cli/export-logs.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:providers": "vitest run tests/integration/",
    "test:all": "vitest run tests/ tests/integration/",
    "lint": "eslint src/",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mcp",
    "search",
    "ai",
    "agent",
    "duckduckgo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilgizar-valiullin/mcp-web-hound.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.5.0",
    "rimraf": "6.1.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "@xenova/transformers": "2.17.2",
    "sqlite-vec": "0.1.9"
  }
}
